{
  "name": "naciocheck",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "NacioCheck — a local-only browser extension that checks the status of Spanish nationality-by-residence applications. Not affiliated with the Ministerio de Justicia.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run build:chrome",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b firefox",
    "zip:sources": "wxt zip -b firefox --sources",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E_BROWSER=chrome wdio run e2e/wdio.conf.ts",
    "test:e2e:chrome": "E2E_BROWSER=chrome wdio run e2e/wdio.conf.ts",
    "test:e2e:firefox": "E2E_BROWSER=firefox wdio run e2e/wdio.conf.ts",
    "test:e2e:headed": "E2E_HEADED=1 E2E_BROWSER=chrome wdio run e2e/wdio.conf.ts",
    "test:e2e:update-baselines": "rm -rf e2e/baselines && E2E_UPDATE_BASELINES=1 E2E_SPEC=visual E2E_BROWSER=chrome wdio run e2e/wdio.conf.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:site": "node scripts/check-site.mjs",
    "logo:outline": "node scripts/outline-logo.mjs",
    "store:images": "node scripts/store-images.mjs",
    "deploy:site": "wrangler deploy",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/visual-service": "^11.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fontkit": "^3.0.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "webdriverio": "^10.2.0",
    "wrangler": "^4.163.0",
    "wxt": "^0.21.5"
  }
}
