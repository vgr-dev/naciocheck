{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naciocheck-site",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "naciocheck.vgr.cat",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
}
