# Copy to .dev.vars for `npm run dev:site` (wrangler dev, local). .dev.vars is git-ignored.
# Nothing here is a credential: these are Cloudflare's published Turnstile test values.

# Cloudflare's always-pass Turnstile test secret; for wrangler dev only.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Turnstile's test mode always answers with the hostname example.com; for wrangler dev only.
TURNSTILE_EXPECTED_HOSTNAME=example.com
# The origin the Worker sees under wrangler dev; for wrangler dev only. Wrangler's dev proxy rewrites the
# browser's Origin (http://localhost:8787) to the route's host over plain http, so it is neither localhost
# nor the production https origin.
FEEDBACK_ORIGIN=http://naciocheck.vgr.cat
